// The bar. Ported from /etc/xdg/waybar/config.jsonc rather than written fresh:
// same modules, same formats, same icons — waybar's stock config is a good bar,
// and the styling still comes from there too, since narchy only appends its
// palette to the style.css it seeded from /etc/xdg.
//
// What is ours:
//
//   * The workspaces module is `hyprland/workspaces`. Stock names
//     `sway/workspaces`, which under Hyprland renders nothing at all — the
//     whole left half of the bar was empty.
//   * pulseaudio and bluetooth open the pickers in scripts/ on a click. That is
//     the GNOME quick-settings behaviour: choose an output, toggle the radio,
//     connect something already paired. Stock points pulseaudio at pavucontrol,
//     which is a GUI app we do not install.
//   * No window title. `hyprland/window` is the obvious thing to put in the
//     centre and it is not wanted: the title is already in the window, and a
//     bar that rewrites itself on every focus change is a distraction.
//   * The wifi network's name is behind a click. It does not change and it is
//     the longest thing on the bar, so by default the module is one icon; click
//     it for the name and signal, click again to put it away. Details are in
//     the tooltip either way.
//   * No backlight. The brightness keys already do the job and report it
//     themselves; there was nothing to read on the bar. It was also the only
//     coloured thing on it — stock draws it with the moon-phase emoji, which
//     comes out of Noto Color Emoji, the one glyph here no palette could touch.
//   * The modules with no backing on this machine are gone: mpd, custom/media
//     (wants a mediaplayer.py the package does not ship), custom/power,
//     keyboard-state, and battery#bat2 on a laptop with one battery. So is
//     idle_inhibitor, which is subtler — it holds a wayland idle-inhibit lock,
//     and with no hypridle installed and no idle or dpms timeout set in
//     hyprland.lua there is nothing idling for it to hold off. Put it back when
//     something starts blanking the screen.
//
// Every icon is a Font Awesome codepoint, and none of them are in the fonts
// style.css names first — fontconfig falls back to AdwaitaMono Nerd Font, which
// carries that range. So the glyphs here are invisible in most editors and
// impossible to type: copy them, or read them out of the stock config.
{
    // A minimum, not a height: the bar is as tall as the tallest thing in it.
    // 21 only takes effect because metrics.css releases the min-height GTK puts
    // on the workspace buttons — see the comment there before changing this.
    "height": 21,
    "spacing": 4,

    "modules-left": ["hyprland/workspaces", "hyprland/submap"],
    "modules-right": [
        "custom/recording",
        "pulseaudio",
        "bluetooth",
        "network",
        "power-profiles-daemon",
        "cpu",
        "memory",
        "temperature",
        "battery",
        "clock",
        "tray"
    ],

    "hyprland/submap": {
        "format": "<span style=\"italic\">{}</span>",
        "tooltip": false
    },

    // Shows a record mark and the elapsed time while a recording is running,
    // and nothing at all the rest of the time. The recorder binds in
    // hyprland.lua deliberately notify nothing when they start — a notification
    // is drawn over the screen being recorded and ends up in the clip — so this
    // is the only thing that says a recording is in progress.
    //
    // First in modules-right, which is where it costs nothing. The group is
    // packed against the right edge and grows leftwards, so a module appearing
    // at the head of the list extends it to the left and every module already on
    // it keeps its position. Anywhere else in the list, or anywhere in
    // modules-left, the whole bar would shuffle sideways each time a recording
    // starts or stops. The elapsed time gaining a digit moves only this
    // module's own left edge, for the same reason.
    //
    // The script prints json and does the work of deciding whether anything is
    // recording; format is "{}" so the mark and the time come from there and
    // this file holds no private-use codepoint for it.
    //
    // A one second interval rather than a signal from the keybind. The start
    // path cannot signal usefully — the recorder has to be running before the
    // script can see it — and the stop path would race wf-recorder's exit.
    // Polling costs a pgrep per second and is honest about both.
    "custom/recording": {
        "exec": "$HOME/.config/waybar/scripts/recording",
        "return-type": "json",
        "interval": 1,
        "format": "{}"
    },

    // Percentages are padded to three columns, right aligned, so a module keeps
    // one width from 0 to 100 and nothing to its left shifts when a number gains
    // or loses a digit. waybar formats through fmt, so the field spec is fmt's:
    // `{volume:>3}` is a width of three and a right align. The font is monospace,
    // so three columns is three digits' worth of room whatever fills them.
    //
    // Left click picks the output, right click mutes, scroll moves the volume.
    //
    // The bluetooth mark on the two format-bluetooth lines is spaced off the
    // icon before it, where stock butts the two together. Ink is not bound by
    // the cell it advances: in a monospace face every glyph steps one column,
    // but the Font Awesome headphones draw about a column and a half, so with
    // nothing between them the bluetooth rune's stem landed inside the right
    // earcup and the pair read as one broken glyph. A space is a whole column
    // here, which is more than the overhang needs.
    "pulseaudio": {
        "format": "{volume:>3}% {icon} {format_source}",
        "format-bluetooth": "{volume:>3}% {icon}  {format_source}",
        "format-bluetooth-muted": " {icon}  {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume:>3}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "$HOME/.config/waybar/scripts/audio-output",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    // The module needs no config to find bluez — it watches DBus — so all of
    // this is presentation.
    //
    // The glyph is the enclosed bluetooth, U+F293, not the bare rune U+F294 that
    // reads as the obvious choice. The rune is drawn as a narrow upright mark:
    // at the same font-size as every other icon it covers 11px against their
    // 20-23 and looks shrunken next to them, where the enclosed one fills the
    // same box as the speaker and the battery.
    //
    // Off is that glyph at reduced alpha rather than a second icon: Font Awesome
    // has no crossed-out bluetooth, and the module must stay on the bar while it
    // is off or there would be nothing to click to turn it back on.
    "bluetooth": {
        "format": "",
        "format-disabled": "<span alpha='40%'></span>",
        "format-off": "<span alpha='40%'></span>",
        "format-connected": " {num_connections}",
        "tooltip-format": "Bluetooth {status}",
        "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "$HOME/.config/waybar/scripts/bluetooth"
    },

    // format-alt is what the click toggles, and there is only one of it, so it
    // says essid: this machine has no ethernet port, and a dongle's alternate
    // reading blank is a fair trade for the name being one click away. The
    // tooltips need no click at all.
    "network": {
        "format-wifi": "",
        "format-ethernet": "",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠",
        "format-alt": "{essid} ({signalStrength}%) ",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname} via {gwaddr}",
        "tooltip-format-ethernet": "{ipaddr}/{cidr}\n{ifname} via {gwaddr}",
        "tooltip-format-disconnected": "Disconnected"
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },

    "cpu": {
        "format": "{usage:>3}% ",
        "tooltip": false
    },
    "memory": {
        "format": "{:>3}% "
    },
    "temperature": {
        "critical-threshold": 80,
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""]
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity:>3}% {icon}",
        "format-full": "{capacity:>3}% {icon}",
        "format-charging": "{capacity:>3}% ",
        "format-plugged": "{capacity:>3}% ",
        "format-alt": "{time} {icon}",
        "format-icons": ["", "", "", "", ""]
    },

    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },
    "tray": {
        "spacing": 10
    }
}

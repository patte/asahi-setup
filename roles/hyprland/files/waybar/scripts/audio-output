#!/usr/bin/env bash
# The output picker behind waybar's volume module, where GNOME puts it in quick
# settings. Waybar's own menus are a static XML file, which cannot enumerate
# devices that come and go, so a click opens wofi instead — already installed
# for the launcher, and already wearing the same theme as the bar.
set -euo pipefail

current=$(pactl get-default-sink)

# `pactl list sinks` is the only form carrying Description, which is the name a
# person recognises: "MacBook Air J415 Speakers", not
# "audio_effect.j415-convolver".
#
# It is also the only form that says whether the active port is plugged in, and
# that matters: wireplumber will not make an unavailable sink the default, so
# picking the headphones with nothing in the jack silently does nothing. Those
# are dropped from the list, which is what GNOME shows too. A port with no jack
# detection at all reports no availability and stays in.
sinks=$(pactl list sinks | awk '
    function flush(  state) {
        if (name == "") return
        state = (active != "" && active in unavailable) ? "gone" : "here"
        print state "\t" name "\t" description
    }
    /^Sink #/ { flush(); name = ""; description = ""; active = ""; delete unavailable }
    /^[[:space:]]+Name:/ { name = $2 }
    /^[[:space:]]+Description:/ {
        description = $0
        sub(/^[[:space:]]+Description:[[:space:]]*/, "", description)
    }
    /not available\)$/ {
        port = $0
        sub(/^[[:space:]]+/, "", port)
        sub(/:.*/, "", port)
        unavailable[port] = 1
    }
    /^[[:space:]]+Active Port:/ {
        active = $0
        sub(/^[[:space:]]+Active Port:[[:space:]]*/, "", active)
    }
    END { flush() }')

# A bullet marks the one in use — U+25CF, which the monospace wofi resolves to
# actually has, unlike the Nerd Font icons the bar itself can rely on. Both
# markers are two columns wide, so the names line up.
declare -A sink_of
labels=()
while IFS=$'\t' read -r state name description; do
    [[ $state == here ]] || continue
    if [[ $name == "$current" ]]; then
        label="● $description"
    else
        label="  $description"
    fi
    sink_of[$label]=$name
    labels+=("$label")
done <<<"$sinks"

((${#labels[@]})) || exit 0

choice=$(printf '%s\n' "${labels[@]}" |
    wofi --dmenu --insensitive --cache-file /dev/null \
        --prompt "Output" --width 360 --height 240) || exit 0

# Escape exits wofi non-zero, but a killed wofi and an empty filter both come
# back as a successful nothing — and an empty subscript is a hard error on an
# associative array, so it has to be caught before the lookup.
[[ -n $choice ]] || exit 0
sink=${sink_of[$choice]-}
[[ -n $sink ]] || exit 0

pactl set-default-sink "$sink"

# Streams already playing do not follow the default, so whatever you were
# listening to would keep coming out of the old device. Inputs with no client
# are skipped: those are filter chains — the convolver in front of the built-in
# speakers is one — and moving them reroutes the filter, not the sound.
pactl list short sink-inputs | awk '$3 != "-" { print $1 }' | while read -r id; do
    pactl move-sink-input "$id" "$sink" || true
done

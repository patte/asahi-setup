{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "atuin hook claude-code",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "atuin hook claude-code",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "atuin hook claude-code",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  },
  "inputNeededNotifEnabled": false,
  "model": "opus",
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "preferredNotifChannel": "notifications_disabled",
  "skipDangerousModePermissionPrompt": true,
  "spinnerTipsEnabled": false,
  "theme": "dark",
  "tui": "fullscreen"
}
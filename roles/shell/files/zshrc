# ── Prompt (pure zsh, no external dependencies) ──────────────────────
setopt prompt_subst
autoload -Uz vcs_info add-zsh-hook
zmodload zsh/datetime

# Git info: branch, staged (+), unstaged (*), untracked (?)
zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:*' check-for-changes true
zstyle ':vcs_info:*' unstagedstr '*'
zstyle ':vcs_info:*' stagedstr '+'
zstyle ':vcs_info:git:*' formats       '%b%u%c'
zstyle ':vcs_info:git:*' actionformats '%b %F{red}(%a)%f%u%c'
zstyle ':vcs_info:git*+set-message:*' hooks git-untracked
+vi-git-untracked() {
    if git rev-parse --is-inside-work-tree &>/dev/null && \
       [[ -n $(git ls-files --others --exclude-standard --directory \
                            --no-empty-directory 2>/dev/null | head -n 1) ]]; then
        hook_com[unstaged]+='?'
    fi
}

# Time the previous command
typeset -F _prompt_start=0
_prompt_preexec() { _prompt_start=$EPOCHREALTIME }
_prompt_precmd() {
    local -F elapsed=0
    (( _prompt_start > 0 )) && elapsed=$(( EPOCHREALTIME - _prompt_start ))
    _prompt_start=0

    _prompt_took=''
    if (( elapsed >= 2 )); then
        if (( elapsed >= 3600 )); then
            _prompt_took=$(printf '%dh%dm' $((elapsed/3600)) $((elapsed%3600/60)))
        elif (( elapsed >= 60 )); then
            _prompt_took=$(printf '%dm%ds' $((elapsed/60)) $((elapsed%60)))
        else
            _prompt_took=$(printf '%.1fs' $elapsed)
        fi
    fi

    vcs_info
    print -Pn '\e]0;%n@%m: %~\a'   # terminal title
}
add-zsh-hook preexec _prompt_preexec
add-zsh-hook precmd  _prompt_precmd

# Show user@host only when it isn't the local machine
if [[ -n $SSH_CONNECTION || -n $SSH_TTY ]]; then
    _prompt_host='%F{243}%n%F{240}@%F{243}%m%f  '
else
    _prompt_host=''
fi

PROMPT='
${_prompt_host}%B%F{39}%~%f%b'\
'${VIRTUAL_ENV:+"  %F{240}(${VIRTUAL_ENV:t})%f"}'\
'${vcs_info_msg_0_:+"  %F{240}on%f %F{magenta}${vcs_info_msg_0_}%f"}
%(?.%F{76}.%F{203})❯%f '

RPROMPT='%(1j.%F{240}[%j]%f  .)'\
'${_prompt_took:+"%F{240}${_prompt_took}%f  "}'\
'%(?..%F{203}✗%?%f  )'\
'%F{240}%D{%H:%M}%f'

# History
HISTFILE=~/.histfile
HISTSIZE=1000
SAVEHIST=1000000

# Editor
export EDITOR="nvim"

export PATH="$HOME/.local/bin:$PATH"

# Personal customizations

# Aliases
alias gis='git status'
alias gif='git difftool'
alias gil='git log --decorate'
alias grep='grep --color=auto'
alias vi='nvim'

# Atuin
. "$HOME/.atuin/bin/env"
eval "$(atuin init zsh)"

# Reuse SSH sock in zellij/tmux (check BEFORE setting stable path)
_ORIG_SOCK="${SSH_AUTH_SOCK:-}"
if [[ "$_ORIG_SOCK" == *"code-server"* ]] || [[ ! -S "$_ORIG_SOCK" ]]; then
    REAL_SOCK=$(find /tmp -type s -path "*/auth-agent*/listener.sock" 2>/dev/null | head -n 1)
    if [ -S "$REAL_SOCK" ]; then
        ln -sf "$REAL_SOCK" ~/.ssh/ssh_auth_sock
    fi
elif [ -S "$_ORIG_SOCK" ] && [[ "$_ORIG_SOCK" != ~/.ssh/ssh_auth_sock ]]; then
    # Valid socket from environment, update symlink
    ln -sf "$_ORIG_SOCK" ~/.ssh/ssh_auth_sock
fi
unset _ORIG_SOCK

# Always use the stable location
export SSH_AUTH_SOCK=~/.ssh/ssh_auth_sock

. "$HOME/.cargo/env"
